# Credenciais do Firebase (console.firebase.google.com → Configurações do projeto → Seus apps → Web).
# Copie este arquivo para `.env` (local) e cadastre as mesmas variáveis na Vercel (Settings → Environment Variables).
# Sem essas variáveis o site funciona em "modo local": tudo salvo só no navegador, sem login — útil para desenvolver.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Opcional (Google Analytics do Firebase):
VITE_FIREBASE_MEASUREMENT_ID=
